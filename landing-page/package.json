{
  "name": "safespace-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/prepare-screenshots.mjs",
    "predev": "npm run images",
    "dev": "vite",
    "prebuild": "npm run images",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-screenshots.mjs && npm run images",
    "og": "node scripts/capture-og.mjs",
    "check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
